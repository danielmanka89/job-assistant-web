// Database schema. Row shapes are mapped to the API types in lib/types.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique // stored lowercased
  name            String
  passwordHash    String // bcrypt hash; never returned by the API
  role            String            @default("SEEKER") // "SEEKER" | "EMPLOYER"
  clockTemplate   String            @default("MINIMALIST") // dashboard clock style: "MINIMALIST" | "NEON" | "GLASS"
  // The candidate's color theme for the whole app (buttons, links, clocks…): "BLUE" | "GREEN" | "RED".
  // Stored in the column first added for clock colors.
  themeColor      String            @default("RED") @map("clockColor")
  // Link to the profile photo ("/api/profile/photo/<id>?v=<saved at>"); null shows initials instead.
  // The image itself is in ProfilePhoto, so loading a user never loads the picture.
  profilePictureUrl String?
  // The small round photo in the menu, uploaded and cropped separately; null uses the portfolio photo.
  avatarUrl       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  resumes         Resume[]
  gapAnalyses     GapAnalysis[]
  tailoredResumes TailoredResume[]
  generatedFiles  GeneratedFile[]
  jobPostings     JobPosting[]
  sessions        Session[]
  submissions     Submission[]
  profile         CandidateProfile?
  learningPaths   LearningPath[]
  deadlines       Deadline[]
  profilePhoto    ProfilePhoto?
  avatarPhoto     AvatarPhoto?
  introduction    Introduction?
  connectionsFrom Connection[]      @relation("ConnectionFrom")
  connectionsTo   Connection[]      @relation("ConnectionTo")
  conversationsA  Conversation[]    @relation("ConversationA")
  conversationsB  Conversation[]    @relation("ConversationB")
  messages        Message[]
  // The name part of this account's project email address (Inbox), e.g. "daniel.k7x2"; the domain is
  // EMAIL_DOMAIN. Given the first time the account opens its inbox, then never changed.
  mailboxName     String?           @unique
  emails          EmailMessage[]
}

// "fromUser is connected to toUser" (Chat > People), labelled with what they are to them. One-way,
// like following: A can be connected to B without B being connected to A. The account's two counts
// are the rows from the user and the rows to the user.
model Connection {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("ConnectionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("ConnectionTo", fields: [toUserId], references: [id], onDelete: Cascade)
  kind       String   @default("friend") // ConnectionKind: "friend" | "vendor" | "employer" | "recruiter" | "colleague" | "other"
  createdAt  DateTime @default(now())

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

// A one-to-one chat. The two users are stored in id order (userAId < userBId) so a pair has one row.
model Conversation {
  id            String    @id @default(cuid())
  userAId       String
  userA         User      @relation("ConversationA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId       String
  userB         User      @relation("ConversationB", fields: [userBId], references: [id], onDelete: Cascade)
  aLastReadAt   DateTime? // when each side last opened the chat; later messages from the other side are unread
  bLastReadAt   DateTime?
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  messages      Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// One email in a user's project inbox (Inbox): received at their project address ("in") or sent
// from it ("out"). Only plain text is kept; HTML mail is converted when it arrives.
model EmailMessage {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction   String // "in" | "out"
  providerId  String? // the email service's id for this email; a webhook delivered twice is stored once
  fromAddress String
  fromName    String    @default("")
  toAddress   String // "out": who it was sent to; "in": the project address it arrived at
  subject     String
  body        String // plain text
  preview     String    @default("") // the start of the body, for the list (which never loads bodies)
  attachments Json      @default("[]") // string[]: file names only; the files themselves aren't kept
  messageId   String? // the email's Message-ID header, so a reply threads in the other person's mailbox
  readAt      DateTime? // null while an incoming email is unread
  createdAt   DateTime  @default(now())

  @@unique([userId, providerId])
  @@index([userId, createdAt])
}

// The candidate's AI-written interview introduction (My Profile > My Introduction), kept so it opens
// instantly next time. Rewritten on request, or when it was made from an older resume.
model Introduction {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId   String // the resume it was written from
  paragraphs Json // string[]
  wordCount  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// The menu photo: a square cropped in the browser for the small circle in the sidebar. Only its owner
// ever sees it (the public portfolio uses ProfilePhoto).
model AvatarPhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String // image/jpeg, image/png or image/webp
  updatedAt DateTime @updatedAt
}

// A user's profile photo, prepared in the browser before upload (at most 1.5 MB): either the whole
// picture at its own shape, or cropped to a square for the circle.
model ProfilePhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mimeType  String // image/jpeg, image/png or image/webp
  width     Int? // pixels; null for photos saved before sizes were kept (they're squares)
  height    Int?
  updatedAt DateTime @updatedAt
}

model Resume {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFileName     String? // original upload name, e.g. "Jane_Doe_CV.pdf"
  storedFileName     String // unique file name; older rows keep the file in /uploads
  mimeType           String // application/pdf or DOCX
  fileSize           Int // bytes
  data               Bytes? // file contents (serverless hosts have no persistent disk)
  contact            Json // ResumeContact
  summary            String?
  workExperience     Json // WorkExperience[]
  education          Json // Education[]
  skills             Json // string[]
  certifications     Json? // string[]; null for resumes uploaded before certifications were read
  marketReachPercent Int? // Market Reach when uploaded (baseline); null for older resumes until first viewed
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  gapAnalyses        GapAnalysis[]
  tailored           TailoredResume[]

  @@index([userId])
}

model GapAnalysis {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId         String
  resume           Resume           @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescription   String
  matchedKeywords  Json // string[]
  missingKeywords  Json // string[]
  suggestedBullets Json // SuggestedBullet[]
  createdAt        DateTime         @default(now())
  tailored         TailoredResume[]

  @@index([userId])
  @@index([resumeId])
}

// The "after" resume: the source resume with only the user-accepted bullets merged in.
model TailoredResume {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceResumeId    String
  sourceResume      Resume          @relation(fields: [sourceResumeId], references: [id], onDelete: Cascade)
  gapAnalysisId     String
  gapAnalysis       GapAnalysis     @relation(fields: [gapAnalysisId], references: [id], onDelete: Cascade)
  acceptedBulletIds Json // string[]
  contact           Json // ResumeContact
  summary           String?
  workExperience    Json // WorkExperience[]
  education         Json // Education[]
  skills            Json // string[]
  finalMatchPercent Int? // score of the generated file; null for rows created before it was stored
  createdAt         DateTime        @default(now())
  files             GeneratedFile[]

  @@index([userId])
}

model GeneratedFile {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tailoredResumeId String
  tailoredResume   TailoredResume @relation(fields: [tailoredResumeId], references: [id], onDelete: Cascade)
  format           String // "docx" | "pdf"
  fileName         String // download name, e.g. "Jane_Doe_Resume.pdf"
  storedFileName   String // unique file name; older rows keep the file in /uploads/tailored/<userId>
  mimeType         String
  fileSize         Int // bytes
  data             Bytes? // file contents (serverless hosts have no persistent disk)
  createdAt        DateTime       @default(now())

  @@index([userId])
}

// Jobs posted on the site ("native") or pulled from an external provider.
model JobPosting {
  id          String       @id @default(cuid())
  title       String
  company     String
  location    String
  description String // full job description text
  applyUrl    String // http(s) only
  source      String // "native" | "adzuna" | "mock"
  externalId  String? // the provider's id; null for native jobs
  postedById  String? // user who posted a native job
  postedBy    User?        @relation(fields: [postedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  submissions Submission[]

  @@unique([source, externalId])
  @@index([createdAt])
}

// One job application, shown as a row on each of the four Spreadsheet sheets. Each sheet's cells
// are a JSON object of column key -> text; lib/spreadsheet.ts lists the columns.
model Submission {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostingId String? // the job applied to; null for rows added by hand or whose job was removed
  jobPosting   JobPosting? @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  vendor       Json // SheetValues: Vendor Information
  submission   Json // SheetValues: Submission Details
  skills       Json // SheetValues: Skill Matrix
  client       Json // SheetValues: Client Information
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  mockCallPrep MockCallPrep?

  @@unique([userId, jobPostingId]) // applying twice to the same job reuses the row
  @@index([userId, createdAt])
}

// Mock call preparation for one submission (Spreadsheet > Submission Details > Mock Call Prep):
// 50 interview questions with answers, written by the AI from the job description and the resume.
model MockCallPrep {
  submissionId   String     @id
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  resumeId       String // the resume the answers were written from
  jobDescription String? // pasted by the user for rows added by hand; null when it comes from the job posting
  questions      Json // PrepQuestion[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// The job seeker's saved profile, one per user. Used when they apply to a job (Spreadsheet row)
// and when they tailor a resume; lib/profile.ts lists the fields.
model CandidateProfile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  values      Json // ProfileValues
  // Set when the candidate approves sharing their public portfolio (/profile/<userId>); null = private.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// A deadline the user added themselves in the sidebar's deadline tracker. Interviews, follow-ups and
// learning in the tracker come from Submission and LearningPath rows instead (lib/deadlines.ts).
model Deadline {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  dueOn     String // "YYYY-MM-DD", the same shape as the Spreadsheet's date cells
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dueOn])
}

// A skill the user chose to learn from the Learning page, with their roadmap progress.
model LearningPath {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillName      String
  status         String   @default("interested") // "interested" | "in_progress" | "completed"
  progress       Int      @default(0) // 0-100, share of roadmap steps completed
  completedSteps Json     @default("[]") // string[] of roadmap step ids
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, skillName])
}

// A logged-in browser. The cookie holds a random token; only its HMAC is stored, so a copy of
// the database can't be used to log in. Logout deletes the row, which ends the session everywhere it was copied.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Motivational quotes for the banner at the bottom of the dashboard. Seeded with 250 by the
// 20261104120000_quotes migration; GET /api/quotes/random picks one.
model Quote {
  id     Int     @id @default(autoincrement())
  text   String  @unique
  author String?
}
