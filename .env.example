# Copy this file to .env and fill in real values. Never commit .env.
# Supabase Postgres. The app uses the transaction pooler (port 6543); Prisma
# migrations use the session pooler (port 5432). Both usernames are postgres.<project-ref>.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
ANTHROPIC_API_KEY="your-anthropic-api-key"
SESSION_SECRET="replace-with-a-long-random-string"

# Frontend: set to "true" to use local mock API responses instead of the backend.
NEXT_PUBLIC_MOCK_API="false"

# External job provider for GET /api/jobs: "mock" (10 demo jobs) or "none".
EXTERNAL_JOBS_PROVIDER="mock"

# Project email (Inbox). Leave all four empty to run without email: the Inbox then says it isn't set up.
# EMAIL_DOMAIN is the part after the @ of every account's address: your Resend receiving address
# domain ("<id>.resend.app") or a domain you verified in Resend ("mail.example.com").
EMAIL_DOMAIN=""
# Resend API key ("re_..."): reads received emails and sends.
RESEND_API_KEY=""
# Signing secret ("whsec_...") of the Resend webhook for the event email.received,
# pointed at https://<your site>/api/email/inbound
RESEND_WEBHOOK_SECRET=""
# Set to "true" once EMAIL_DOMAIN is verified for sending in Resend; until then the Inbox is receive-only.
EMAIL_SENDING=""
